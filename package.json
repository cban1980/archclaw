{
  "name": "archclaw",
  "version": "2.0.0",
  "description": "Let Claude run your Arch/Omarchy desktop from your phone: a remote MCP server with scenes, apps on screens, Spotify, and safe power actions",
  "main": "src/cli.ts",
  "scripts": {
    "start": "node src/cli.ts serve",
    "check": "node src/cli.ts check",
    "typecheck": "tsc",
    "test": "node --test test/*.test.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cban1980/archclaw.git"
  },
  "keywords": [
    "arch-linux",
    "claude",
    "mcp",
    "mcp-server",
    "hyprland",
    "omarchy",
    "home-automation",
    "spotify",
    "systemd",
    "voice-control"
  ],
  "license": "Unlicense",
  "type": "module",
  "bugs": {
    "url": "https://github.com/cban1980/archclaw/issues"
  },
  "homepage": "https://github.com/cban1980/archclaw#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "bin": {
    "archclaw": "src/cli.ts"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.11",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.18"
  },
  "private": true
}
