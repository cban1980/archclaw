{
  "name": "archnest",
  "version": "1.0.0",
  "description": "Control an Arch/Omarchy PC by voice with Google Home / Nest: a Matter bridge with locks, lights, dimmers, apps on screens, Spotify handoff and safe power actions",
  "main": "src/cli.ts",
  "scripts": {
    "start": "node src/cli.ts serve",
    "check": "node src/cli.ts check",
    "typecheck": "tsc",
    "test": "node --test test/*.test.ts",
    "routines": "node src/cli.ts routines"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cban1980/archnest.git"
  },
  "keywords": [
    "arch-linux",
    "google-home",
    "home-automation",
    "hyprland",
    "matter",
    "nest",
    "omarchy",
    "spotify",
    "systemd",
    "voice-control"
  ],
  "license": "Unlicense",
  "type": "module",
  "bugs": {
    "url": "https://github.com/cban1980/archnest/issues"
  },
  "homepage": "https://github.com/cban1980/archnest#readme",
  "dependencies": {
    "@matter/main": "^0.18.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "bin": {
    "archnest": "src/cli.ts"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.11",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.18"
  },
  "private": true
}
