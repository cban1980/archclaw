# Rendered by bootstrap.sh into ~/.config/systemd/user/archclaw.service.
# @NODE@ and @APPDIR@ are replaced with absolute paths.

[Unit]
Description=archclaw - lets Claude control this PC (MCP connector)
Documentation=file://@APPDIR@/README.md
# Runs inside the desktop session: actions need Hyprland, PipeWire and notifications,
# and stopping with the session means nothing acts on a half-torn-down desktop.
PartOf=graphical-session.target
After=graphical-session.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=@APPDIR@
ExecStart=@NODE@ @APPDIR@/src/cli.ts serve
Environment=NODE_ENV=production
Restart=on-failure
RestartSec=5
# Shutdown/reboot go through logind's D-Bus API, which needs no extra privileges.
NoNewPrivileges=yes
# Let in-flight requests finish.
TimeoutStopSec=10

[Install]
WantedBy=graphical-session.target
